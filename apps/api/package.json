{
  "name": "@aimers/api",
  "version": "0.0.0",
  "private": true,
  "description": "AIMERS OS application API",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "predev": "pnpm --filter @aimers/database build",
    "prebuild": "pnpm --filter @aimers/database build",
    "pretypecheck": "pnpm --filter @aimers/database build",
    "seed:dev-users": "dotenv -e .env -- tsx scripts/seed-dev-users.ts",
    "seed:dev-mock-test": "dotenv -e .env -- tsx scripts/seed-dev-mock-test.ts",
    "seed:dev-question-bank": "dotenv -e .env -- tsx scripts/seed-dev-question-bank.ts",
    "seed:dev-flashcards": "dotenv -e .env -- tsx scripts/seed-dev-flashcards.ts"
  },
  "dependencies": {
    "@aimers/database": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
