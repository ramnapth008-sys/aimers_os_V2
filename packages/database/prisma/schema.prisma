model Flashcard {
  id               String              @id @default(uuid()) @db.Uuid
  deckId           String              @map("deck_id") @db.Uuid
  studentProfileId String              @map("student_profile_id") @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  chapterId        String?             @map("chapter_id") @db.Uuid
  topicId          String?             @map("topic_id") @db.Uuid
  sourceQuestionId String?             @map("source_question_id") @db.Uuid
  sourceType       FlashcardSourceType @default(MANUAL) @map("source_type")
  status           FlashcardStatus     @default(ACTIVE)
  front            String              @db.Text
  back             String              @db.Text
  hint             String?             @db.Text
  mnemonic         String?             @db.Text
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  sourceQuestion Question? @relation("FlashcardSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  schedule           FlashcardSchedule?
  reviews            FlashcardReview[]
  reviewSessionItems FlashcardReviewSessionItem[]

  @@unique([deckId, sourceQuestionId])
  @@index([studentProfileId, status])
  @@index([deckId, status])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([sourceQuestionId])
  @@map("flashcards")
}

model FlashcardSchedule {
  id             String                 @id @default(uuid()) @db.Uuid
  flashcardId    String                 @unique @map("flashcard_id") @db.Uuid
  state          FlashcardLearningState @default(NEW)
  dueAt          DateTime               @default(now()) @map("due_at") @db.Timestamptz(6)
  intervalDays   Int                    @default(0) @map("interval_days")
  scheduleStep   Int                    @default(0) @map("schedule_step")
  easeFactor     Float                  @default(2.5) @map("ease_factor")
  repetitions    Int                    @default(0)
  lapseCount     Int                    @default(0) @map("lapse_count")
  lastReviewedAt DateTime?              @map("last_reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([state, dueAt])
  @@index([dueAt])
  @@map("flashcard_schedules")
}

model FlashcardReviewSession {
  id               String                       @id @default(uuid()) @db.Uuid
  studentProfileId String                       @map("student_profile_id") @db.Uuid
  deckId           String?                      @map("deck_id") @db.Uuid
  status           FlashcardReviewSessionStatus @default(ACTIVE)
  totalCards       Int                          @default(0) @map("total_cards")
  reviewedCards    Int                          @default(0) @map("reviewed_cards")
  againCount       Int                          @default(0) @map("again_count")
  hardCount        Int                          @default(0) @map("hard_count")
  goodCount        Int                          @default(0) @map("good_count")
  easyCount        Int                          @default(0) @map("easy_count")
  durationSeconds  Int                          @default(0) @map("duration_seconds")
  startedAt        DateTime                     @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?                    @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  deck FlashcardDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  reviews FlashcardReview[]
  items   FlashcardReviewSessionItem[]

  @@index([studentProfileId, status, startedAt])
  @@index([deckId, status])
  @@map("flashcard_review_sessions")
}

model FlashcardReview {
  id                   String                 @id @default(uuid()) @db.Uuid
  reviewSessionId      String                 @map("review_session_id") @db.Uuid
  flashcardId          String                 @map("flashcard_id") @db.Uuid
  rating               FlashcardReviewRating
  previousState        FlashcardLearningState @map("previous_state")
  newState             FlashcardLearningState @map("new_state")
  previousIntervalDays Int                    @default(0) @map("previous_interval_days")
  newIntervalDays      Int                    @default(0) @map("new_interval_days")
  responseSeconds      Int                    @default(0) @map("response_seconds")
  reviewedAt           DateTime               @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewSession FlashcardReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([reviewSessionId, flashcardId])
  @@index([reviewSessionId, reviewedAt])
  @@index([flashcardId, reviewedAt])
  @@index([rating, reviewedAt])
  @@map("flashcard_reviews")
}

model FlashcardReviewSessionItem {
  id              String    @id @default(uuid()) @db.Uuid
  reviewSessionId String    @map("review_session_id") @db.Uuid
  flashcardId     String    @map("flashcard_id") @db.Uuid
  sequenceNumber  Int       @map("sequence_number")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviewSession FlashcardReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
