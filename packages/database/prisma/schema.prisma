  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionType {
  GENTLE_NUDGE
  FOCUS_SESSION
  BLOCK_APP
  BLOCK_WEBSITE
  RESCHEDULE_TASK
  MENTOR_CHECK_IN
  REVISION_REMINDER
  RECOVERY_PLAN
}

enum InterventionStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
  ACTIVE
  COMPLETED
  EXPIRED
}

enum InterventionResponseType {
  ACCEPTED
  DISMISSED
  SNOOZED
  HELPFUL
  NOT_HELPFUL
  COMPLETED
}

model ConsentGrant {
  id               String           @id @default(uuid()) @db.Uuid
  studentProfileId String           @map("student_profile_id") @db.Uuid
  scope            ConsentScope
  status           ConsentStatus    @default(PENDING)
  actorType        ConsentActorType @default(STUDENT) @map("actor_type")
  grantedByUserId  String?          @map("granted_by_user_id") @db.Uuid
  policyVersion    String           @map("policy_version") @db.VarChar(40)
  grantedForMinor  Boolean          @default(false) @map("granted_for_minor")
  grantedAt        DateTime?        @map("granted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz(6)
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]

  @@index([studentProfileId, status])
  @@index([scope, status])
  @@index([expiresAt])
  @@map("consent_grants")
}

model PrivacyPreference {
  id                       String    @id @default(uuid()) @db.Uuid
  studentProfileId         String    @unique @map("student_profile_id") @db.Uuid
  monitoringEnabled        Boolean   @default(false) @map("monitoring_enabled")
  backgroundMonitoring     Boolean   @default(false) @map("background_monitoring")
  crossDeviceSync          Boolean   @default(false) @map("cross_device_sync")
  storeRawActivity         Boolean   @default(false) @map("store_raw_activity")
  storeFullUrls            Boolean   @default(false) @map("store_full_urls")
  importPastHistory        Boolean   @default(false) @map("import_past_history")
  allowAiContext           Boolean   @default(false) @map("allow_ai_context")
  allowBehaviorAnalysis    Boolean   @default(false) @map("allow_behavior_analysis")
  allowNotifications       Boolean   @default(false) @map("allow_notifications")
  allowFocusControls       Boolean   @default(false) @map("allow_focus_controls")
  localProcessingPreferred Boolean   @default(true) @map("local_processing_preferred")
  minorModeEnabled         Boolean   @default(false) @map("minor_mode_enabled")
  guardianApprovalRequired Boolean   @default(false) @map("guardian_approval_required")
  rawRetentionDays         Int       @default(30) @map("raw_retention_days")
  summaryRetentionDays     Int       @default(365) @map("summary_retention_days")
  pausedAt                 DateTime? @map("paused_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("privacy_preferences")
}

model ConnectedDevice {
  id                  String         @id @default(uuid()) @db.Uuid
  studentProfileId    String         @map("student_profile_id") @db.Uuid
  externalDeviceId    String         @map("external_device_id") @db.VarChar(200)
  name                String         @db.VarChar(160)
  platform            DevicePlatform
  status              DeviceStatus   @default(PENDING)
  appVersion          String?        @map("app_version") @db.VarChar(80)
  osVersion           String?        @map("os_version") @db.VarChar(120)
  lastSeenAt          DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  lastSyncAt          DateTime?      @map("last_sync_at") @db.Timestamptz(6)
  monitoringStartedAt DateTime?      @map("monitoring_started_at") @db.Timestamptz(6)
  monitoringPausedAt  DateTime?      @map("monitoring_paused_at") @db.Timestamptz(6)
  metadata            Json?
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  connectors       DataConnector[]
  activityEvents   ActivityEvent[]
  activitySessions ActivitySession[]
  lectureSessions  LectureSession[]

  @@unique([studentProfileId, externalDeviceId])
  @@index([studentProfileId, status])
  @@index([status, lastSeenAt])
  @@map("connected_devices")
}

model DataConnector {
  id                   String              @id @default(uuid()) @db.Uuid
  studentProfileId     String              @map("student_profile_id") @db.Uuid
  connectedDeviceId    String?             @map("connected_device_id") @db.Uuid
  type                 DataConnectorType
  status               DataConnectorStatus @default(PENDING)
  displayName          String              @map("display_name") @db.VarChar(160)
  externalAccountId    String?             @map("external_account_id") @db.VarChar(240)
  permissions          Json?
  syncCursor           String?             @map("sync_cursor") @db.Text
  lastSyncAt           DateTime?           @map("last_sync_at") @db.Timestamptz(6)
  lastSuccessfulSyncAt DateTime?           @map("last_successful_sync_at") @db.Timestamptz(6)
  errorMessage         String?             @map("error_message") @db.Text
  metadata             Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile  StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  connectedDevice ConnectedDevice? @relation(fields: [connectedDeviceId], references: [id], onDelete: SetNull)
  activityEvents  ActivityEvent[]
  lectureSessions LectureSession[]

  @@index([studentProfileId, status])
  @@index([connectedDeviceId, status])
  @@index([type, status])
  @@index([lastSyncAt])
  @@map("data_connectors")
}

model ActivityEvent {
  id                  String              @id @default(uuid()) @db.Uuid
  studentProfileId    String              @map("student_profile_id") @db.Uuid
  connectedDeviceId   String?             @map("connected_device_id") @db.Uuid
  dataConnectorId     String?             @map("data_connector_id") @db.Uuid
  consentGrantId      String?             @map("consent_grant_id") @db.Uuid
  eventKey            String?             @map("event_key") @db.VarChar(240)
  type                ActivityEventType
  source              ActivitySource
  category            ActivityCategory    @default(UNKNOWN)
  confidence          DataConfidenceLevel @default(OBSERVED)
  appName             String?             @map("app_name") @db.VarChar(200)
  domain              String?             @db.VarChar(320)
  pageTitle           String?             @map("page_title") @db.VarChar(500)
  externalReferenceId String?             @map("external_reference_id") @db.VarChar(240)
  subjectId           String?             @map("subject_id") @db.Uuid
  chapterId           String?             @map("chapter_id") @db.Uuid
  topicId             String?             @map("topic_id") @db.Uuid
  startedAt           DateTime            @map("started_at") @db.Timestamptz(6)
  endedAt             DateTime?           @map("ended_at") @db.Timestamptz(6)
  durationSeconds     Int?                @map("duration_seconds")
  foreground          Boolean             @default(true)
  metadata            Json?
  ingestedAt          DateTime            @default(now()) @map("ingested_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  studentProfile  StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  connectedDevice ConnectedDevice? @relation(fields: [connectedDeviceId], references: [id], onDelete: SetNull)
  dataConnector   DataConnector?   @relation(fields: [dataConnectorId], references: [id], onDelete: SetNull)
  consentGrant    ConsentGrant?    @relation(fields: [consentGrantId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, eventKey])
  @@index([studentProfileId, startedAt])
  @@index([connectedDeviceId, startedAt])
  @@index([dataConnectorId, startedAt])
  @@index([category, startedAt])
  @@index([subjectId, chapterId, topicId])
  @@map("activity_events")
}

model ActivitySession {
  id                           String              @id @default(uuid()) @db.Uuid
  studentProfileId             String              @map("student_profile_id") @db.Uuid
  connectedDeviceId            String?             @map("connected_device_id") @db.Uuid
  source                       ActivitySource
  category                     ActivityCategory    @default(UNKNOWN)
  confidence                   DataConfidenceLevel @default(OBSERVED)
  appName                      String?             @map("app_name") @db.VarChar(200)
  domain                       String?             @db.VarChar(320)
  startedAt                    DateTime            @map("started_at") @db.Timestamptz(6)
  endedAt                      DateTime?           @map("ended_at") @db.Timestamptz(6)
  durationSeconds              Int?                @map("duration_seconds")
  focusedSeconds               Int                 @default(0) @map("focused_seconds")
  interruptionCount            Int                 @default(0) @map("interruption_count")
  concurrentDistractionSeconds Int                 @default(0) @map("concurrent_distraction_seconds")
