model ResearchProject {
  id               String                @id @default(uuid()) @db.Uuid
  studentProfileId String                @map("student_profile_id") @db.Uuid
  subjectId        String?               @map("subject_id") @db.Uuid
  chapterId        String?               @map("chapter_id") @db.Uuid
  topicId          String?               @map("topic_id") @db.Uuid
  title            String                @db.VarChar(240)
  description      String?               @db.Text
  researchQuestion String?               @map("research_question") @db.Text
  status           ResearchProjectStatus @default(ACTIVE)
  color            String?               @db.VarChar(32)
  icon             String?               @db.VarChar(64)
  isPinned         Boolean               @default(false) @map("is_pinned")
  lastOpenedAt     DateTime?             @map("last_opened_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  archivedAt       DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter        Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic          Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  sources      ResearchSource[]
  threads      ResearchThread[]
  mindMapNodes ResearchMindMapNode[]
  mindMapEdges ResearchMindMapEdge[]

  @@index([studentProfileId, status, isPinned, updatedAt])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@map("research_projects")
}

model ResearchSource {
  id                String               @id @default(uuid()) @db.Uuid
  studentProfileId  String               @map("student_profile_id") @db.Uuid
  researchProjectId String               @map("research_project_id") @db.Uuid
  sourceNoteId      String?              @map("source_note_id") @db.Uuid
  type              ResearchSourceType
  status            ResearchSourceStatus @default(SAVED)
  title             String               @db.VarChar(300)
  url               String?              @db.Text
  author            String?              @db.VarChar(240)
  publisher         String?              @db.VarChar(240)
  publishedAt       DateTime?            @map("published_at") @db.Timestamptz(6)
  accessedAt        DateTime?            @map("accessed_at") @db.Timestamptz(6)
  rawContent        String?              @map("raw_content") @db.Text
  summary           String?              @db.Text
  citationText      String?              @map("citation_text") @db.Text
  citationKey       String?              @map("citation_key") @db.VarChar(120)
  reliabilityScore  Int?                 @map("reliability_score")
  isPinned          Boolean              @default(false) @map("is_pinned")
  metadata          Json?
  processingError   String?              @map("processing_error") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  sourceNote      Note?           @relation("ResearchSourceNote", fields: [sourceNoteId], references: [id], onDelete: SetNull)

  excerpts     ResearchSourceExcerpt[]
  citations    ResearchCitation[]
  mindMapNodes ResearchMindMapNode[]

  @@unique([researchProjectId, citationKey])
  @@index([studentProfileId, status, updatedAt])
  @@index([researchProjectId, status, isPinned, updatedAt])
  @@index([sourceNoteId])
  @@index([type, status])
  @@map("research_sources")
}

model ResearchSourceExcerpt {
  id               String   @id @default(uuid()) @db.Uuid
  researchSourceId String   @map("research_source_id") @db.Uuid
  quote            String   @db.Text
  note             String?  @db.Text
  locator          String?  @db.VarChar(160)
  pageNumber       Int?     @map("page_number")
  startOffset      Int?     @map("start_offset")
  endOffset        Int?     @map("end_offset")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchSource ResearchSource     @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)
  citations      ResearchCitation[]

  @@index([researchSourceId, createdAt])
  @@index([pageNumber])
  @@map("research_source_excerpts")
}

model ResearchThread {
  id                String   @id @default(uuid()) @db.Uuid
  studentProfileId  String   @map("student_profile_id") @db.Uuid
  researchProjectId String   @map("research_project_id") @db.Uuid
  title             String   @db.VarChar(240)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  messages ResearchMessage[]

  @@index([studentProfileId, updatedAt])
  @@index([researchProjectId, updatedAt])
