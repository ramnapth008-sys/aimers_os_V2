}

model ResearchMessage {
  id               String              @id @default(uuid()) @db.Uuid
  researchThreadId String              @map("research_thread_id") @db.Uuid
  role             ResearchMessageRole
  content          String              @db.Text
  model            String?             @db.VarChar(120)
  promptTokens     Int?                @map("prompt_tokens")
  completionTokens Int?                @map("completion_tokens")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  researchThread ResearchThread     @relation(fields: [researchThreadId], references: [id], onDelete: Cascade)
  citations      ResearchCitation[]

  @@index([researchThreadId, createdAt])
  @@map("research_messages")
}

model ResearchCitation {
  id                      String   @id @default(uuid()) @db.Uuid
  researchMessageId       String   @map("research_message_id") @db.Uuid
  researchSourceId        String   @map("research_source_id") @db.Uuid
  researchSourceExcerptId String?  @map("research_source_excerpt_id") @db.Uuid
  label                   String?  @db.VarChar(120)
  quote                   String?  @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  researchMessage       ResearchMessage        @relation(fields: [researchMessageId], references: [id], onDelete: Cascade)
  researchSource        ResearchSource         @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)
  researchSourceExcerpt ResearchSourceExcerpt? @relation(fields: [researchSourceExcerptId], references: [id], onDelete: SetNull)

  @@index([researchMessageId])
  @@index([researchSourceId])
  @@index([researchSourceExcerptId])
  @@map("research_citations")
}

model ResearchMindMapNode {
  id                String                  @id @default(uuid()) @db.Uuid
  researchProjectId String                  @map("research_project_id") @db.Uuid
  researchSourceId  String?                 @map("research_source_id") @db.Uuid
  noteId            String?                 @map("note_id") @db.Uuid
  type              ResearchMindMapNodeType @default(CONCEPT)
  title             String                  @db.VarChar(240)
  content           String?                 @db.Text
  positionX         Float                   @default(0) @map("position_x")
  positionY         Float                   @default(0) @map("position_y")
  color             String?                 @db.VarChar(32)
  sequenceNumber    Int                     @default(0) @map("sequence_number")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  researchSource  ResearchSource? @relation(fields: [researchSourceId], references: [id], onDelete: SetNull)
  note            Note?           @relation("ResearchMindMapNodeNote", fields: [noteId], references: [id], onDelete: SetNull)

  outgoingEdges ResearchMindMapEdge[] @relation("ResearchMindMapOutgoing")
  incomingEdges ResearchMindMapEdge[] @relation("ResearchMindMapIncoming")

  @@index([researchProjectId, sequenceNumber])
  @@index([researchSourceId])
  @@index([noteId])
  @@map("research_mind_map_nodes")
}

model ResearchMindMapEdge {
  id                String   @id @default(uuid()) @db.Uuid
  researchProjectId String   @map("research_project_id") @db.Uuid
  sourceNodeId      String   @map("source_node_id") @db.Uuid
  targetNodeId      String   @map("target_node_id") @db.Uuid
  label             String?  @db.VarChar(160)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  researchProject ResearchProject     @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  sourceNode      ResearchMindMapNode @relation("ResearchMindMapOutgoing", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      ResearchMindMapNode @relation("ResearchMindMapIncoming", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([researchProjectId])
  @@index([targetNodeId])
  @@map("research_mind_map_edges")
}

