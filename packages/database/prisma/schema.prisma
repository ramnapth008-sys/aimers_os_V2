model BehaviorSignal {
  id                String              @id @default(uuid()) @db.Uuid
  studentProfileId  String              @map("student_profile_id") @db.Uuid
  type              BehaviorSignalType
  severity          BehaviorSeverity
  confidenceScore   Float               @map("confidence_score")
  dataConfidence    DataConfidenceLevel @default(OBSERVED) @map("data_confidence")
  title             String              @db.VarChar(240)
  description       String              @db.Text
  evidence          Json
  recommendedAction String?             @map("recommended_action") @db.Text
  periodStart       DateTime?           @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime?           @map("period_end") @db.Timestamptz(6)
  detectedAt        DateTime            @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  interventions  Intervention[]

  @@index([studentProfileId, detectedAt])
  @@index([type, severity, detectedAt])
  @@index([resolvedAt])
  @@map("behavior_signals")
}

model Intervention {
  id               String             @id @default(uuid()) @db.Uuid
  studentProfileId String             @map("student_profile_id") @db.Uuid
  behaviorSignalId String?            @map("behavior_signal_id") @db.Uuid
  type             InterventionType
  status           InterventionStatus @default(SUGGESTED)
  title            String             @db.VarChar(240)
  message          String             @db.Text
  actionConfig     Json?              @map("action_config")
  scheduledAt      DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  deliveredAt      DateTime?          @map("delivered_at") @db.Timestamptz(6)
  respondedAt      DateTime?          @map("responded_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  behaviorSignal BehaviorSignal?        @relation(fields: [behaviorSignalId], references: [id], onDelete: SetNull)
  responses      InterventionResponse[]

  @@index([studentProfileId, status, scheduledAt])
  @@index([behaviorSignalId])
  @@index([expiresAt])
  @@map("interventions")
}

model InterventionResponse {
  id             String                   @id @default(uuid()) @db.Uuid
  interventionId String                   @map("intervention_id") @db.Uuid
  responseType   InterventionResponseType @map("response_type")
  note           String?                  @db.Text
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId, createdAt])
  @@index([responseType, createdAt])
  @@map("intervention_responses")
}

model StudentIntelligenceSnapshot {
