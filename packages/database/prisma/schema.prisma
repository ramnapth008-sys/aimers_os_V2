  @@index([studentProfileId, startedAt])
  @@index([connectedDeviceId, startedAt])
  @@index([category, startedAt])
  @@map("activity_sessions")
}

model LectureSession {
  id                      String              @id @default(uuid()) @db.Uuid
  studentProfileId        String              @map("student_profile_id") @db.Uuid
  connectedDeviceId       String?             @map("connected_device_id") @db.Uuid
  dataConnectorId         String?             @map("data_connector_id") @db.Uuid
  externalLectureId       String?             @map("external_lecture_id") @db.VarChar(240)
  platformName            String              @map("platform_name") @db.VarChar(160)
  courseTitle             String?             @map("course_title") @db.VarChar(300)
  lectureTitle            String              @map("lecture_title") @db.VarChar(300)
  subjectId               String?             @map("subject_id") @db.Uuid
  chapterId               String?             @map("chapter_id") @db.Uuid
  topicId                 String?             @map("topic_id") @db.Uuid
  totalDurationSeconds    Int?                @map("total_duration_seconds")
  watchedSeconds          Int                 @default(0) @map("watched_seconds")
  focusedSeconds          Int                 @default(0) @map("focused_seconds")
  playbackPositionSeconds Int                 @default(0) @map("playback_position_seconds")
  completionPercent       Float               @default(0) @map("completion_percent")
  completed               Boolean             @default(false)
  confidence              DataConfidenceLevel @default(OBSERVED)
  startedAt               DateTime            @map("started_at") @db.Timestamptz(6)
  lastProgressAt          DateTime?           @map("last_progress_at") @db.Timestamptz(6)
  completedAt             DateTime?           @map("completed_at") @db.Timestamptz(6)
  metadata                Json?
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile  StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  connectedDevice ConnectedDevice? @relation(fields: [connectedDeviceId], references: [id], onDelete: SetNull)
  dataConnector   DataConnector?   @relation(fields: [dataConnectorId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, startedAt])
  @@index([connectedDeviceId, startedAt])
  @@index([dataConnectorId, startedAt])
  @@index([subjectId, chapterId, topicId])
  @@index([completed, lastProgressAt])
  @@map("lecture_sessions")
}

model DailyActivitySummary {
  id                   String              @id @default(uuid()) @db.Uuid
  studentProfileId     String              @map("student_profile_id") @db.Uuid
  summaryDate          DateTime            @map("summary_date") @db.Date
  timezone             String              @db.VarChar(80)
  monitoredSeconds     Int                 @default(0) @map("monitored_seconds")
  studySeconds         Int                 @default(0) @map("study_seconds")
  productiveSeconds    Int                 @default(0) @map("productive_seconds")
  distractionSeconds   Int                 @default(0) @map("distraction_seconds")
  idleSeconds          Int                 @default(0) @map("idle_seconds")
  focusedStudySeconds  Int                 @default(0) @map("focused_study_seconds")
  lectureSeconds       Int                 @default(0) @map("lecture_seconds")
  revisionSeconds      Int                 @default(0) @map("revision_seconds")
  socialSeconds        Int                 @default(0) @map("social_seconds")
  entertainmentSeconds Int                 @default(0) @map("entertainment_seconds")
  contextSwitches      Int                 @default(0) @map("context_switches")
  longestFocusSeconds  Int                 @default(0) @map("longest_focus_seconds")
  coveragePercent      Float               @default(0) @map("coverage_percent")
  confidence           DataConfidenceLevel @default(MISSING)
  metrics              Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

