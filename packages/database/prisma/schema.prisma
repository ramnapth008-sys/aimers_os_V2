  studentProfileId         String              @map("student_profile_id") @db.Uuid
  periodStart              DateTime            @map("period_start") @db.Timestamptz(6)
  periodEnd                DateTime            @map("period_end") @db.Timestamptz(6)
  generatedAt              DateTime            @default(now()) @map("generated_at") @db.Timestamptz(6)
  coveragePercent          Float               @default(0) @map("coverage_percent")
  predictionConfidence     DataConfidenceLevel @default(MISSING) @map("prediction_confidence")
  academicReadinessScore   Float?              @map("academic_readiness_score")
  focusScore               Float?              @map("focus_score")
  revisionConsistencyScore Float?              @map("revision_consistency_score")
  distractionRiskScore     Float?              @map("distraction_risk_score")
  overloadRiskScore        Float?              @map("overload_risk_score")
  features                 Json
